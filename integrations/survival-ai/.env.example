# Copy these names into your app's local environment file.
# Get the values from your own Supabase project's Connect/API settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never put a Supabase service_role/secret key in a browser app or commit it.
