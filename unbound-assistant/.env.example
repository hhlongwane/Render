# Server-only secrets. Never commit real values to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_AUDIO_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Optional; only enable if the selected model supports the Responses API shell tool.
ENABLE_SHELL_TOOL=false

# Optional isolated Linux coding and reverse-engineering workspace (E2B).
# Create a key at https://e2b.dev/ and add it only to the server environment.
E2B_API_KEY=

# Required: use a long random password (at least 16 characters) to protect API spending.
APP_ACCESS_PASSWORD=

# Optional video generation via Replicate. Choose a currently available model slug from Replicate.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=
# Optional JSON object of extra inputs for the selected model, e.g. {"aspect_ratio":"16:9"}
REPLICATE_VIDEO_DEFAULT_INPUT={}
PORT=3000
