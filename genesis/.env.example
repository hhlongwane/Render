# Configure these in the separate GENESIS service environment.
# Do not commit real secrets.
OMNISEC_APP_PASSWORD=replace-with-a-random-secret-at-least-16-characters
OMNISEC_SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
PORT=3030
# Set the URL to the Survival AI service and use the same dedicated secret configured there.
SURVIVAL_AI_BASE_URL=https://survival-ai-gmd5.onrender.com
SURVIVAL_AI_INTEGRATION_TOKEN=replace-with-a-long-random-secret
